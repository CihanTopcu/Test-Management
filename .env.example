# Kopyalayin: cp .env.example .env  — sonra en az iki satiri degistirin.

# --- zorunlu ---------------------------------------------------------------
DB_PASSWORD=degistirin-guclu-bir-parola
SECRET_KEY=degistirin-rastgele-64-karakter

# --- opsiyonel -------------------------------------------------------------
DB_NAME=testmgmt
DB_USER=tm
WEB_PORT=8080
# e-postadaki baglantilar bu adresle kurulur
PUBLIC_URL=http://test-yonetimi.dgpays.local:8080

# --- istek siniri ----------------------------------------------------------
# Giris denemeleri ve otomasyon yazmalari icin. Yalnizca test kosarken
# kapatin; acik birakmak dogru olan.
RATE_LIMIT_ENABLED=true

# --- e-posta (bos birakilirsa bildirimler yalnizca uygulama icinde kalir) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=test-yonetimi@dgpays.com
SMTP_STARTTLS=true

# --- ilk kurulum yoneticisi (bos birakilirsa parola log'a yazilir) ---------
BOOTSTRAP_EMAIL=admin@dgpays.com
BOOTSTRAP_PASSWORD=

# --- TestRail goc araclari -------------------------------------------------
TESTRAIL_URL=https://dgpaysit.testrail.com
TESTRAIL_USER=
TESTRAIL_KEY=

# --- TestRail otomatik esitleme --------------------------------------------
# TestRail kapanana kadar, degisiklikleri periyodik olarak bu tarafa ceker.
# Acmadan once TESTRAIL_USER/KEY doldurulmus olmali ve data/ dizininde
# ilk dokum bulunmali. TestRail kapandiginda false yapin.
TESTRAIL_SYNC_ENABLED=false
# saniye cinsinden; 604800 = bir hafta
TESTRAIL_SYNC_INTERVAL=604800
# ilk esitlemenin nereden baslayacagi (bos = son bir hafta)
TESTRAIL_SYNC_SINCE=

# --- Jira (istege bagli, yalnizca okuma) -----------------------------------
# Case referanslarindaki ve sonuc hatalarindaki PROJE-123 anahtarlari Jira'ya
# baglanir ve yaninda guncel durumu gosterilir. Token sunucuda kalir.
# Kalici kullanim icin kisisel degil bir servis hesabi onerilir.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Test otomasyonu (tarayicida kosan senaryolar) ---------------------------
# Yerelde tarayici gorunur acilir; sunucuda true yapin (ekran yoktur).
AUTOTEST_HEADLESS=false
# Duz metinden komut taslagi icin (istege bagli). Bos birakilirsa komutlar
# elle yazilir; kosumlar yapay zeka kullanmaz.
ANTHROPIC_API_KEY=

# --- Kurumsal hesapla giris (istege bagli, OpenID Connect) ------------------
# Entra ID icin: https://login.microsoftonline.com/<tenant id>/v2.0
# Bos birakilirsa yalnizca parolayla giris vardir. Ayrintilar DEPLOY.md'de.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Microsoft
